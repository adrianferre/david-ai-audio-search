    "ai": "^7.0.179",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
