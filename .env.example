# Documents the variables in .env.local. Don't copy it by hand: run
# `vercel env pull .env.local`, which writes every value from the Vercel
# project. Never commit .env.local. Variables the app reads must also be
# declared in src/env.ts so they are validated at build/dev time.

# Neon Postgres, pooled URL. Required on Vercel; optional locally. When it is
# empty, `pnpm dev` proxies /api/* to API_UPSTREAM_URL (the deployed, rate-limited
# API) instead of querying the database.
DATABASE_URL=

# Private Vercel Blob store with the FLAC files. Required on Vercel; optional
# locally (not needed while /api/* is proxied). Reads authenticate with
# VERCEL_OIDC_TOKEN, which `vercel env pull` also writes. It expires after a few
# hours; @vercel/blob refreshes it as long as the folder is linked (.vercel/)
# and you are logged in to the Vercel CLI.
BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=

# Vercel AI Gateway, for the search embeddings and transcriptions. Nothing to set by default: the AI SDK
# authenticates with VERCEL_OIDC_TOKEN too. Set a key only to use one instead of OIDC
# (`vercel ai-gateway api-keys create`).
# AI_GATEWAY_API_KEY=

# `vercel env pull` also writes the other Neon variables of the project.

# Deployed API used when DATABASE_URL is empty. Defaults to production.
# API_UPSTREAM_URL=https://david-ai-audio-search.vercel.app

# EXAMPLE_API_KEY=
# NEXT_PUBLIC_EXAMPLE_URL=http://localhost:3000
