# Documents the variables in .env.local. Don't copy it by hand: run
# `vercel env pull .env.local`, which writes every value from the Vercel
# project. Never commit .env.local. Variables the app reads must also be
# declared in src/env.ts so they are validated at build/dev time.

# Neon Postgres. The app uses the pooled URL; `pnpm catalog:sync` prefers the unpooled one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Private Vercel Blob store (only `pnpm catalog:sync` uses it for now).
# Auth is OIDC: the token expires after ~12 h, refresh it with `vercel env pull`.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# EXAMPLE_API_KEY=
# NEXT_PUBLIC_EXAMPLE_URL=http://localhost:3000
